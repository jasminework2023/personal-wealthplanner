# Isi 3 ini di Vercel > Project Settings > Environment Variables
# (BUKAN di file ini -- file ini cuma contoh, jangan taruh nilai asli di sini)

# Dari Supabase > Settings > API > "Project URL"
SUPABASE_URL=

# Dari Supabase > Settings > API > "anon public" key (BUKAN service_role)
SUPABASE_ANON_KEY=

# Isi JSON service account yang SAMA PERSIS dengan punya bot Telegram di Railway
GOOGLE_CREDENTIALS=
