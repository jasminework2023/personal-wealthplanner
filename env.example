# Server-only environment variables for Vercel
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CREDENTIALS=
# Receipt AI: Groq dicoba lebih dulu (gratis), OpenAI jadi cadangan.
# Isi salah satu atau keduanya. Pastikan nama model valid di console masing-masing.
GROQ_API_KEY=
GROQ_RECEIPT_MODEL=
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini

# Payment endpoints (only if payment features are enabled)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
LYNK_MERCHANT_KEY=
GOOGLE_TEMPLATE_URL=

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Wealthplanner <hello@wealthplanner.id>

# Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=wealthplannerAI
TELEGRAM_WEBHOOK_SECRET=
